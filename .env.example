# Mini-Agent 环境变量模板
#
# 用法：cp .env.example .env 然后填上自己的值。
# .env 已经在 .gitignore 里，不会被提交；也可以直接设成系统环境变量。
# 优先级：环境变量 > config.json > 代码默认值。

# ---------- 模型 ----------
# 选哪家：anthropic / openai / deepseek / qwen / moonshot / zhipu / minimax / mimo
#         / ollama / openai_compatible / mock
MINI_AGENT_PROVIDER=anthropic

# API Key。各厂商惯用的名字也认（见下面注释掉的那几个），不必重复填。
MINI_AGENT_API_KEY=

# 只填实际用到的那一个即可：
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# DASHSCOPE_API_KEY=sk-...        # 通义千问
# MOONSHOT_API_KEY=sk-...         # Kimi
# ZHIPU_API_KEY=...               # 智谱 GLM
# MINIMAX_API_KEY=sk-api-...      # MiniMax
# MIMO_API_KEY=sk-...             # 小米 MiMo

# 模型名。留空则用该厂商的示例模型
# （claude-opus-5 / deepseek-v4-pro / qwen3.8-max / kimi-k3 / glm-5.3 …）
MINI_AGENT_MODEL=

# 自建端点或代理才需要填
MINI_AGENT_BASE_URL=

# ---------- 运行参数 ----------
# ReAct 最大步数，防止模型无限调用工具
MINI_AGENT_MAX_STEPS=8
# 记忆保留的最大轮数
MINI_AGENT_MAX_TURNS=20
# 是否流式输出
MINI_AGENT_STREAM=true
# 打印每一步的中间过程
MINI_AGENT_VERBOSE=false
# 把 DEBUG 日志写到文件（全过程可追溯）
MINI_AGENT_LOG_FILE=

# ---------- 工具 ----------
# 文件工具的活动范围（沙箱根目录），模型只能读写这里面
MINI_AGENT_WORKSPACE=./workspace
# 关掉就只允许读文件
MINI_AGENT_ALLOW_FILE_WRITE=true
# 是否允许 http_request 访问内网地址（默认禁止，防 SSRF）
MINI_AGENT_HTTP_ALLOW_PRIVATE=false
# 域名白名单（逗号分隔）。本机代理软件开 fake-ip 时，所有域名都会解析到 198.18.x.x
# 而被 SSRF 防线拦下，用这个按域名精准放行，比上面那个开关安全得多：
#   MINI_AGENT_HTTP_ALLOWED_HOSTS=er-api.com,api.frankfurter.app
MINI_AGENT_HTTP_ALLOWED_HOSTS=
# 工具结果的**兜底**字符上限，防止一次工具调用把上下文冲爆。设 0 表示不限。
# 取内容的工具（read_file / http_request）不受它约束，正文原样返回，见 README §3.1
MINI_AGENT_MAX_TOOL_RESULT_CHARS=8000

# 联网搜索（可选）。配了才会启用 web_search 工具
TAVILY_API_KEY=

# 工具白名单 / 黑名单，逗号分隔，如：calculator,get_current_time
MINI_AGENT_ENABLED_TOOLS=
MINI_AGENT_DISABLED_TOOLS=

# ---------- 浏览器界面 ----------
# 访问口令。留空 = 不鉴权，只在本机用。
# 挂公网（内网穿透）时**必须**设，否则服务拒绝启动——见 README §2.9 和 §9。
# 只放环境变量，别写进 config.json：那个文件是会被提交的。起一个长一点的随机串。
MINI_AGENT_WEB_ACCESS_TOKEN=

# 内网穿透域名，逗号分隔（也可以用 --public-host 传）。这些名字会被加进 Host 白名单。
MINI_AGENT_WEB_PUBLIC_HOSTS=
